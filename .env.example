# ===== Root compose configuration (copy to .env) =====
# Database credentials (used by Postgres + backend connection string)
POSTGRES_USER=iom
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=iom

# Backend
ENVIRONMENT=development
SEED_DEMO_DATA=true
# Origins allowed to call the API (the frontend URL)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Frontend -> backend API base URL (baked into the build)
VITE_API_URL=http://localhost:8000/api
